# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime directories — regenerated on every run, not source
uploads/
# Legacy pre-accounts data. Real league configs must not ship to every install:
# the first account to register would inherit them.
configs/
output/

# Shared run state, written per-run so it survives across worker processes
.run_state.json
.run_state.json.tmp

# Host-specific deployment files. The .example versions are committed; these
# carry per-host edits (interpreter path, data dir) and must stay untracked so
# a git pull cannot overwrite them.
.htaccess
dispatch.cgi

# Editor / tooling
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Accounts, per-user files and the session signing key. Never commit these.
data/
