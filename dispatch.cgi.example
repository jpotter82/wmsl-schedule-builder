#!/usr/bin/env python3
"""CGI entry point, for shared hosting without Passenger ("Setup Python App").

Every request starts a fresh Python process, so nothing survives in memory between
them. That is fine here:

  * Runs are scored a slice per request, so no single request is long enough to be
    killed and there is no background work to keep alive. SKEDWORX_SYNC_RUNS is no
    longer read; leaving it set does nothing.
  * Run state is mirrored to .run_state.json by app.py, so /api/status and
    /api/results can read the result of a run performed by an earlier process.

Startup is roughly 0.55s to import the scheduler, and a slice of attempts adds a
few seconds, so the longest request is well inside normal CGI limits no matter how
many attempts the run asks for.

Setup:
  cp dispatch.cgi.example dispatch.cgi
  chmod 755 dispatch.cgi
  # CGI does not inherit your shell's PATH, so 'python3' often fails. Point the
  # shebang above at an absolute interpreter, e.g.
  #   sed -i '1s|.*|#!/usr/bin/python3.9|' dispatch.cgi
  #
  # dispatch.cgi itself is gitignored precisely because it needs these host-specific
  # edits; keeping it untracked means git pull can never clobber them.
"""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

# Recommended on shared hosting: keep accounts, password hashes and the session
# key outside the web root, so they cannot be fetched over HTTP even if .htaccess
# is misconfigured. Create the directory (chmod 700) and uncomment.
# os.environ.setdefault('SKEDWORX_DATA_DIR', '/home/USERNAME/skedworx-data')

# Settings kept OUTSIDE the web root.
#
# This file lives in the document root, so anything written here is one broken
# handler away from being served as plain text -- and a mailbox password is worth
# protecting from that. Put credentials in a file above the root instead:
#
#     ~/skedworx-secrets.env      chmod 600
#
#     SKEDWORX_SMTP_HOST=mail.example.com
#     SKEDWORX_SMTP_PORT=587
#     SKEDWORX_SMTP_USER=noreply@example.com
#     SKEDWORX_SMTP_PASSWORD=the-mailbox-password
#     SKEDWORX_SMTP_FROM=skedworx <noreply@example.com>
#     SKEDWORX_BASE_URL=https://example.com
#
# KEY=VALUE per line. Blank lines and # comments ignored; values are taken
# literally, so do not quote them and do not escape anything.
_SECRETS = os.path.join(os.path.expanduser('~'), 'skedworx-secrets.env')
if os.path.exists(_SECRETS):
    with open(_SECRETS, encoding='utf-8') as _fh:
        for _line in _fh:
            _line = _line.strip()
            if not _line or _line.startswith('#') or '=' not in _line:
                continue
            _k, _, _v = _line.partition('=')
            os.environ.setdefault(_k.strip(), _v.strip())

# Or set them here instead, accepting that they sit in the web root.
#
# SKEDWORX_BASE_URL matters as much as the credentials: without it the link in the
# mail is built from the Host header, which the requester controls, so a forged
# request could mail you a link pointing at someone else's site.
#
# os.environ.setdefault('SKEDWORX_BASE_URL', 'https://schedule.wmsl.ca')
# os.environ.setdefault('SKEDWORX_SMTP_HOST', 'mail.wmsl.ca')
# os.environ.setdefault('SKEDWORX_SMTP_PORT', '587')
# os.environ.setdefault('SKEDWORX_SMTP_USER', 'skedworx@wmsl.ca')
# os.environ.setdefault('SKEDWORX_SMTP_PASSWORD', '...')
# os.environ.setdefault('SKEDWORX_SMTP_FROM', 'skedworx <skedworx@wmsl.ca>')

# Surface tracebacks in the browser instead of a bare 500 while setting things up.
# Comment out once it is working -- it exposes file paths and source to visitors.
#
# cgitb was deprecated in Python 3.11 and REMOVED in 3.13, so this is optional:
# without it you get a plain 500 and have to read the server error log instead.
try:
    import cgitb  # noqa: E402
    cgitb.enable()
except ImportError:
    pass

from wsgiref.handlers import CGIHandler  # noqa: E402
from app import app  # noqa: E402


class _ScriptNameFix(object):
    """Strip the CGI script name from PATH_INFO.

    With the .htaccess rewrite the request arrives as /dispatch.cgi/api/status while
    Flask should route /api/status. Clearing SCRIPT_NAME keeps url_for() emitting
    plain paths so the page's own fetch() calls resolve correctly.
    """

    def __init__(self, wsgi_app):
        self.wsgi_app = wsgi_app

    def __call__(self, environ, start_response):
        environ['SCRIPT_NAME'] = ''
        return self.wsgi_app(environ, start_response)


CGIHandler().run(_ScriptNameFix(app))
